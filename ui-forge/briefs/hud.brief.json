{
  "screen": "hud",
  "pattern": "hud-overlay",
  "purpose": "keep area-completion progress, the collection count and upgrade costs readable while the player is moving",
  "variant": {
    "layout": "corners",
    "readoutStyle": "pill",
    "bar": "chunky",
    "density": "compact",
    "anchor": "inset"
  },
  "ornament": { "readoutTrim": "none", "barCap": "round" },
  "content": {
    "readouts": [
      { "label": "FINDS", "value": "0 / 24", "icon": "find", "cluster": "topLeft" },
      { "label": "SHARDS", "value": "0", "icon": "shard", "cluster": "topRight" },
      { "label": "VALUE", "value": "Lv 0  -  25", "cluster": "bottomRight" },
      { "label": "REACH", "value": "Lv 0  -  40", "cluster": "bottomRight" },
      { "label": "PACE", "value": "Lv 0  -  60", "cluster": "bottomRight" }
    ],
    "progress": { "label": "EAST TERRACE - 0% CLEAR", "value": 0, "cluster": "bottomLeft" }
  }
}
